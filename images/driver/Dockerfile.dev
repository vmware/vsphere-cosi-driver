# Dev only, used by hack/deploy-kind-cluster.sh. It wraps a binary built on the host (for the
# kind node's architecture) instead of building in a builder stage like the release Dockerfile,
# so it is not the release artifact. scratch has no CA bundle: add one before the driver makes
# TLS calls to S3 or vSphere.
ARG BASE_IMAGE=scratch

FROM ${BASE_IMAGE}

ARG BINARY

COPY ${BINARY} /bin/vsphere-cosi

ENTRYPOINT ["/bin/vsphere-cosi"]
